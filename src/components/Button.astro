---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  isExternal?: boolean;
}

const { href, variant = 'primary', class: className = '', isExternal = false } = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-sans font-semibold text-[14px] tracking-[0.05em] uppercase transition-all duration-300 px-6 py-3 rounded-md";

const variants = {
  primary: "bg-primary text-on-primary hover:bg-primary-container hover:text-on-primary-container",
  secondary: "bg-transparent border border-outline text-on-background hover:bg-surface-variant hover:border-outline-variant",
  ghost: "bg-transparent text-on-background hover:bg-surface-variant/50"
};

const Tag = href ? 'a' : 'button';
const externalProps = isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<Tag href={href} class={`${baseStyles} ${variants[variant]} ${className}`} {...externalProps}>
  <slot />
</Tag>
