---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  
  const paths = await Promise.all(productos.map(async (producto) => {
    const catId = producto.data.categoria?.slug || producto.data.categoria?.id || producto.data.categoria;
    const catEntry = await getEntry('categorias', String(catId));
    const resolvedCatName = catEntry ? catEntry.data.nombre : String(catId);
    
    return {
      params: { slug: producto.slug },
      props: { 
        producto,
        resolvedCatName
      }
    };
  }));
  
  return paths;
}

const { producto, resolvedCatName } = Astro.props;
const { Content } = await producto.render();

const formatPrice = (price: number) => {
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0,
  }).format(price);
};

const whatsappText = encodeURIComponent(`Hola, estoy interesado en el mueble "${producto.data.nombre}" que vi en el catálogo.`);
const whatsappLink = `https://wa.me/${siteConfig.whatsappNumber}?text=${whatsappText}`;

// Schema.org Product
const productSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": producto.data.nombre,
  "image": `https://mueblesgumilla.com${producto.data.imagenes[0].imagen.src}`,
  "description": producto.data.descripcion_corta || producto.data.descripcion_larga,
  "brand": {
    "@type": "Brand",
    "name": "Muebles Gumilla"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "CLP",
    "price": producto.data.precio_referencial,
    "availability": "https://schema.org/MadeToOrder",
    "url": `https://mueblesgumilla.com/catalogo/${producto.slug}`
  }
});
---

<BaseLayout 
  title={`${producto.data.nombre} - Catálogo Muebles Gumilla`}
  description={producto.data.descripcion_corta || producto.data.descripcion_larga.substring(0, 150) + "..."}
  image={producto.data.imagenes[0].imagen.src}
  type="product"
>
  <!-- Schema.org Product -->
  <script type="application/ld+json" set:html={productSchema}></script>

  <div class="max-w-[1440px] mx-auto px-margin-mobile lg:px-margin-desktop py-section-gap">
    
    <!-- Breadcrumbs (simple) -->
    <nav class="flex items-center gap-2 text-sm text-on-surface-variant font-sans mb-8">
      <a href="/" class="hover:text-primary transition-colors">Inicio</a>
      <span>/</span>
      <a href="/catalogo" class="hover:text-primary transition-colors">Catálogo</a>
      <span>/</span>
      <span class="text-on-background">{producto.data.nombre}</span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
      
      <!-- Galería Carrusel -->
      <div class="w-full lg:w-1/2 group relative">
        <div id="carousel-container" class="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide gap-4 pb-4">
          {producto.data.imagenes.map((img: any, idx: number) => (
            <div class="flex-none w-full snap-center relative aspect-[4/5] sm:aspect-square md:max-h-[500px] lg:max-h-[600px] p-5 md:p-6 bg-white border-2 border-white rounded-2xl shadow-md">
              <div class="relative w-full h-full rounded-xl overflow-hidden bg-beige-700 shadow-inner">
                <Image 
                  src={img.imagen} 
                  alt={img.alt || `Imagen ${idx + 1} de ${producto.data.nombre}`} 
                  class="absolute inset-0 w-full h-full object-cover"
                  width={800}
                  height={800}
                  quality={90}
                />
              </div>
            </div>
          ))}
        </div>
        
        {producto.data.imagenes.length > 1 && (
          <>
            <!-- Flechas (Solo desktop, on hover) -->
            <button id="btn-prev" aria-label="Imagen anterior" class="absolute left-4 top-1/2 -translate-y-1/2 bg-surface/80 hover:bg-surface text-on-background p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hidden lg:flex items-center justify-center shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button id="btn-next" aria-label="Siguiente imagen" class="absolute right-4 top-1/2 -translate-y-1/2 bg-surface/80 hover:bg-surface text-on-background p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hidden lg:flex items-center justify-center shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            
            <!-- Puntos indicadores -->
            <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-2 z-10 pointer-events-none">
              {producto.data.imagenes.map((_: any, idx: number) => (
                <div class={`carousel-dot w-2 h-2 rounded-full transition-colors ${idx === 0 ? 'bg-on-background' : 'bg-outline-variant/60'}`} data-index={idx}></div>
              ))}
            </div>
          </>
        )}
      </div>

      <!-- Información -->
      <div class="w-full lg:w-1/2 flex flex-col pt-4 lg:pt-10">
        <div class="flex flex-col gap-2 mb-6">
          <span class="uppercase tracking-wider text-xs font-semibold text-outline">
            {resolvedCatName}
          </span>
          <h1 class="font-serif text-3xl md:text-5xl text-on-background">{producto.data.nombre}</h1>
          <p class="font-sans text-2xl text-on-surface-variant mt-2">{formatPrice(producto.data.precio_referencial)}</p>
          <p class="font-sans text-sm text-outline italic mt-1">{producto.data.precio_nota}</p>
        </div>

        <div class="mb-8">
          <p class="font-sans text-lg text-on-background leading-relaxed">
            {producto.data.descripcion_larga}
          </p>
        </div>

        <div class="border-t border-b border-outline/10 py-6 mb-8 grid grid-cols-2 gap-y-6 gap-x-8">
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-xs uppercase tracking-wider text-outline font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
              Material
            </span>
            <span class="text-on-background font-sans">{producto.data.material}</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-xs uppercase tracking-wider text-outline font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Tiempo de fabricación
            </span>
            <span class="text-on-background font-sans">{producto.data.tiempo_fabricacion_estimado}</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-xs uppercase tracking-wider text-outline font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              Dimensiones
            </span>
            <span class="text-on-background font-sans">
              {producto.data.medidas.alto}x{producto.data.medidas.ancho}x{producto.data.medidas.profundidad}{producto.data.medidas.unidad}
            </span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-xs uppercase tracking-wider text-outline font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              Personalizable
            </span>
            <span class="text-on-background font-sans">{producto.data.medidas.personalizable ? 'Sí' : 'Solo medidas fijas'}</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mt-auto">
          <Button href={whatsappLink} variant="primary" isExternal={true} class="w-full sm:w-auto shadow-md">
            Cotizar por WhatsApp
          </Button>
          <Button href="/catalogo" variant="outline" class="w-full sm:w-auto">
            Volver al catálogo
          </Button>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('carousel-container');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const dots = document.querySelectorAll('.carousel-dot');
    
    if (!container) return;
    
    if (btnPrev && btnNext) {
      btnPrev.addEventListener('click', () => {
        container.scrollBy({ left: -container.clientWidth, behavior: 'smooth' });
      });
      btnNext.addEventListener('click', () => {
        container.scrollBy({ left: container.clientWidth, behavior: 'smooth' });
      });
    }
    
    if (dots.length > 0) {
      container.addEventListener('scroll', () => {
        const scrollPos = container.scrollLeft;
        const slideWidth = container.clientWidth;
        const activeIndex = Math.round(scrollPos / slideWidth);
        
        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.classList.remove('bg-outline-variant/60');
            dot.classList.add('bg-on-background');
          } else {
            dot.classList.add('bg-outline-variant/60');
            dot.classList.remove('bg-on-background');
          }
        });
      });
    }
  });
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
