---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const categoriasAll = await getCollection('categorias');
  
  const paths = categoriasAll.map(cat => ({
    params: { categoria: cat.slug },
    props: { currentCategoryId: cat.slug, currentCategoryName: cat.data.nombre }
  }));
  
  paths.push({
    params: { categoria: undefined },
    props: { currentCategoryId: 'all', currentCategoryName: 'Todos' }
  });
  
  return paths;
}

const { currentCategoryId, currentCategoryName } = Astro.props;

const productos = await getCollection('productos');

// Obtener todas las categorías para los botones de filtro
const categoriasAll = await getCollection('categorias');
const categoriasResolved = categoriasAll.map(cat => ({
  id: cat.slug,
  nombre: cat.data.nombre
})).sort((a, b) => a.nombre.localeCompare(b.nombre));

// Filtrar los productos por la categoría actual
const filteredProductos = currentCategoryId === 'all' 
  ? productos 
  : productos.filter(p => {
      const pCatId = String(p.data.categoria?.slug || p.data.categoria?.id || p.data.categoria);
      return pCatId === currentCategoryId;
    });

// Resolver las categorías para cada producto a mostrar
const resolvedProductos = await Promise.all(
  filteredProductos.map(async (prod) => {
    const catId = prod.data.categoria?.slug || prod.data.categoria?.id || prod.data.categoria;
    const catName = categoriasResolved.find(c => c.id === String(catId))?.nombre || String(catId);
    return {
      ...prod,
      resolvedCategoryName: catName,
      resolvedCategoryId: String(catId)
    };
  })
);
---

<BaseLayout title={`Catálogo ${currentCategoryId !== 'all' ? '- ' + currentCategoryName : ''} - Muebles Gumilla`}>
  <div class="max-w-[1440px] mx-auto px-margin-mobile lg:px-margin-desktop py-section-gap">
    
    <div class="mb-12 md:mb-16">
      <h1 class="font-serif text-4xl md:text-5xl text-on-background mb-4">
        {currentCategoryId === 'all' ? 'Catálogo Completo' : currentCategoryName}
      </h1>
      <p class="font-sans text-on-surface-variant max-w-2xl text-lg">
        {currentCategoryId === 'all' 
          ? 'Explora nuestra colección de muebles de madera maciza, fabricados a mano en Santiago de Chile. Cada pieza puede ser adaptada a tus necesidades.' 
          : `Descubre nuestra selección de ${currentCategoryName.toLowerCase()} de madera maciza, creados con técnicas artesanales.`}
      </p>
    </div>

    <!-- Filtros -->
    <div class="flex gap-2 flex-wrap mb-10">
      <a href="/catalogo" class={`filter-btn px-4 py-2 rounded-full font-sans text-sm font-medium transition-colors border ${currentCategoryId === 'all' ? 'bg-on-background text-surface border-on-background' : 'bg-surface text-on-surface-variant border-outline/20 hover:border-outline hover:text-on-background hover:bg-surface-warm'}`}>
        Todos
      </a>
      {categoriasResolved.map(cat => (
        <a href={`/catalogo/${cat.id}`} class={`filter-btn px-4 py-2 rounded-full font-sans text-sm font-medium transition-colors border ${currentCategoryId === cat.id ? 'bg-on-background text-surface border-on-background' : 'bg-surface text-on-surface-variant border-outline/20 hover:border-outline hover:text-on-background hover:bg-surface-warm'}`}>
          {cat.nombre}
        </a>
      ))}
    </div>

    <!-- Grid de productos -->
    {resolvedProductos.length > 0 ? (
      <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6 lg:gap-8">
        {resolvedProductos.map(producto => (
          <div class="h-full">
            <ProductCard 
              nombre={producto.data.nombre}
              categoria={producto.resolvedCategoryName}
              precio_referencial={producto.data.precio_referencial}
              medida_principal={`${producto.data.medidas.alto}x${producto.data.medidas.ancho}x${producto.data.medidas.profundidad}${producto.data.medidas.unidad}`}
              imagen={producto.data.imagenes[0]}
              url={`/catalogo/${producto.slug}`}
            />
          </div>
        ))}
      </div>
    ) : (
      <!-- Empty State -->
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-outline/40 mb-6"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
        <h3 class="font-serif text-2xl text-on-background mb-2">No hay productos disponibles</h3>
        <p class="font-sans text-on-surface-variant max-w-md mx-auto">
          Actualmente no tenemos piezas en esta categoría. Por favor, intenta con otra selección o contáctanos para un pedido personalizado.
        </p>
      </div>
    )}
  </div>

  {currentCategoryId === 'all' && (
    <script>
      // Redirección para URLs heredadas con parámetros (?categoria=slug)
      const urlParams = new URLSearchParams(window.location.search);
      const categoryParam = urlParams.get('categoria');
      if (categoryParam) {
        window.location.replace(`/catalogo/${categoryParam}`);
      }
    </script>
  )}
</BaseLayout>
