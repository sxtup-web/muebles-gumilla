---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCollection, getEntry } from 'astro:content';

const productos = await getCollection('productos');

// Obtener todas las categorías para los botones de filtro
const categoriasAll = await getCollection('categorias');
const categoriasResolved = categoriasAll.map(cat => ({
  id: cat.slug,
  nombre: cat.data.nombre
})).sort((a, b) => a.nombre.localeCompare(b.nombre));

// Resolver las categorías para cada producto
const resolvedProductos = await Promise.all(
  productos.map(async (prod) => {
    const catId = prod.data.categoria?.slug || prod.data.categoria?.id || prod.data.categoria;
    const catName = categoriasResolved.find(c => c.id === String(catId))?.nombre || String(catId);
    return {
      ...prod,
      resolvedCategoryName: catName,
      resolvedCategoryId: String(catId)
    };
  })
);
---

<BaseLayout title="Catálogo - Muebles Gumilla">
  <div class="max-w-[1440px] mx-auto px-margin-mobile lg:px-margin-desktop py-section-gap">
    
    <div class="mb-12 md:mb-16">
      <h1 class="font-serif text-4xl md:text-5xl text-on-background mb-4">Catálogo</h1>
      <p class="font-sans text-on-surface-variant max-w-2xl text-lg">
        Explora nuestra colección de muebles de madera maciza, fabricados a mano en Santiago de Chile. Cada pieza puede ser adaptada a tus necesidades.
      </p>
    </div>

    <!-- Filtros -->
    <div class="flex gap-2 flex-wrap mb-10">
      <button class="filter-btn active bg-on-background text-surface px-4 py-2 rounded-full font-sans text-sm font-medium transition-colors border border-on-background" data-category="all">
        Todos
      </button>
      {categoriasResolved.map(cat => {
        return (
        <button class="filter-btn bg-surface text-on-surface-variant px-4 py-2 rounded-full font-sans text-sm font-medium transition-colors border border-outline/20 hover:border-outline hover:text-on-background" data-category={cat.id}>
          {cat.nombre}
        </button>
        );
      })}
    </div>

    <!-- Grid de productos -->
    <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6 lg:gap-8" id="products-grid">
      {resolvedProductos.map(producto => {
        return (
        <div class="product-item h-full" data-category={producto.resolvedCategoryId}>
          <ProductCard 
            nombre={producto.data.nombre}
            categoria={producto.resolvedCategoryName}
            precio_referencial={producto.data.precio_referencial}
            medida_principal={`${producto.data.medidas.alto}x${producto.data.medidas.ancho}x${producto.data.medidas.profundidad}${producto.data.medidas.unidad}`}
            imagen={producto.data.imagenes[0]}
            url={`/catalogo/${producto.slug}`}
          />
        </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden flex-col items-center justify-center py-20 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-outline/40 mb-6"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
      <h3 class="font-serif text-2xl text-on-background mb-2">No hay productos disponibles</h3>
      <p class="font-sans text-on-surface-variant max-w-md mx-auto">
        Actualmente no tenemos piezas en esta categoría. Por favor, intenta con otra selección o contáctanos para un pedido personalizado.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  // Client-side filtering
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const productItems = document.querySelectorAll('.product-item');
    const emptyState = document.getElementById('empty-state');
    const productsGrid = document.getElementById('products-grid');
    
    // Check URL params for initial state
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('categoria');
    
    const filterProducts = (category: string) => {
      let visibleCount = 0;
      
      productItems.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (category === 'all' || itemCategory === category) {
          (item as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
      
      // Toggle empty state
      if (emptyState && productsGrid) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          productsGrid.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
          productsGrid.classList.remove('hidden');
        }
      }
      
      // Update buttons
      filterButtons.forEach((btn) => {
        if (btn.getAttribute('data-category') === category) {
          btn.classList.add('bg-on-background', 'text-surface', 'border-on-background');
          btn.classList.remove('bg-surface', 'text-on-surface-variant', 'border-outline/20');
        } else {
          btn.classList.remove('bg-on-background', 'text-surface', 'border-on-background');
          btn.classList.add('bg-surface', 'text-on-surface-variant', 'border-outline/20');
        }
      });
    };
    
    // Initialize
    if (categoryParam) {
      filterProducts(categoryParam);
    }
    
    // Event listeners
    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const category = btn.getAttribute('data-category');
        if (category) {
          filterProducts(category);
          
          // Update URL without reload
          const newUrl = category === 'all' ? window.location.pathname : `${window.location.pathname}?categoria=${category}`;
          window.history.pushState({path: newUrl}, '', newUrl);
        }
      });
    });
  });
</script>
