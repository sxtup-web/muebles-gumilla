---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ProductCard from '../components/ProductCard.astro';
import { Image } from 'astro:assets';
import heroHome from '../assets/hero-home.jpg';
import tallerImage from '../assets/productos/img-20260817-wa0014.jpg';
import bosqueChileno from '../assets/bosque-chileno.jpg';
import { siteConfig } from '../config/site';
import { getCollection, getEntry } from 'astro:content';

const productos = await getCollection('productos');
const productosDestacados = productos.filter(p => p.data.destacado).slice(0, 4);

const resolvedDestacados = await Promise.all(
  productosDestacados.map(async (prod) => {
    const categoriaId = prod.data.categoria?.slug || prod.data.categoria?.id || prod.data.categoria;
    const categoryEntry = await getEntry('categorias', String(categoriaId));
    return {
      ...prod,
      resolvedCategoryName: categoryEntry ? categoryEntry.data.nombre : String(categoriaId)
    };
  })
);
const categorias = await getCollection('categorias');
const orderedCategoriesMain = categorias.filter(c => c.data.nombre !== 'Otros').sort((a,b) => a.data.nombre.localeCompare(b.data.nombre));
const categoryOtros = categorias.find(c => c.data.nombre === 'Otros');
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": siteConfig.name || "Muebles Gumilla",
  "image": `https://mueblesgumilla.com${heroHome.src}`,
  "url": "https://mueblesgumilla.com",
  "telephone": siteConfig.whatsappNumber,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Arturo Prat 1963",
    "addressLocality": "Santiago",
    "addressRegion": "Región Metropolitana",
    "addressCountry": "CL"
  },
  "description": siteConfig.description
});
---

<BaseLayout>
  <!-- Schema.org LocalBusiness -->
  <script type="application/ld+json" set:html={schema}></script>

  <!-- Hero Section -->
  <section class="relative w-full h-[80vh] min-h-[600px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 w-full h-full">
      <Image 
        src={heroHome} 
        alt="Muebles Gumilla - Taller Artesanal" 
        class="w-full h-full object-cover"
        width={1920}
        quality={80}
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/20"></div>
    </div>
    <div class="relative z-10 flex flex-col items-center text-center px-6 max-w-3xl">
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-white font-medium mb-4 drop-shadow-md">
        Piezas hechas con propósito, para toda la vida.
      </h1>
      <p class="font-sans text-lg md:text-xl text-white/90 mb-8 max-w-xl font-medium drop-shadow-sm">
        Artesanía en madera desde el corazón de Santiago. Diseños únicos pensados para tu hogar.
      </p>
      <Button href="/catalogo" variant="primary" class="shadow-lg hover:shadow-xl">
        Explorar colección completa
      </Button>
    </div>
  </section>

  <!-- Categorías Destacadas -->
  <section class="section-padding max-w-[1440px] mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
      <h2 class="font-serif text-3xl md:text-4xl text-on-background">Categorías</h2>
      <a href="/catalogo" class="font-sans font-medium text-primary hover:text-on-background transition-colors uppercase tracking-widest text-sm flex items-center gap-2">
        Descubrir opciones

        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 lg:gap-8">
      {orderedCategoriesMain.map(cat => (
        <a href={`/catalogo/${cat.slug}`} class="group flex flex-col transition-transform duration-300 ease-out hover:-translate-y-1">
          <div class="bg-white p-5 sm:p-6 rounded-2xl border-2 border-white shadow-md">
            <div class="relative aspect-square overflow-hidden bg-beige-700 rounded-lg shadow-inner flex items-end p-4 md:p-6">
              <Image 
                src={cat.data.imagen.imagen}
                alt={cat.data.imagen.alt}
                width={400}
                height={400}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent z-10 transition-opacity duration-300"></div>
              <h3 class="relative z-20 font-serif text-2xl text-white drop-shadow-sm group-hover:text-white transition-colors">{cat.data.nombre}</h3>
            </div>
          </div>
        </a>
      ))}
    </div>
    {categoryOtros && (
      <div class="flex justify-center mt-6 lg:mt-8">
        <a href={`/catalogo/${categoryOtros.slug}`} class="group flex flex-col transition-transform duration-300 ease-out hover:-translate-y-1 w-full md:w-[600px] max-w-full">
          <div class="bg-white p-5 sm:p-6 rounded-2xl border-2 border-white shadow-md">
            <div class="relative aspect-[3/2] md:aspect-[3/1] overflow-hidden bg-beige-700 rounded-lg shadow-inner flex items-end p-4 md:p-6">
              <Image 
                src={categoryOtros.data.imagen.imagen}
                alt={categoryOtros.data.imagen.alt}
                width={600}
                height={300}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent z-10 transition-opacity duration-300"></div>
              <h3 class="relative z-20 font-serif text-2xl text-white drop-shadow-sm group-hover:text-white transition-colors">{categoryOtros.data.nombre}</h3>
            </div>
          </div>
        </a>
      </div>
    )}
  </section>

  <!-- Sección SEO Expandida: Catálogo y Filosofía -->
  <section class="py-24 bg-surface-warm/30 my-section-gap border-y border-outline/10">
    <div class="max-w-[1440px] mx-auto px-margin-mobile lg:px-margin-desktop">
      <div class="max-w-4xl mx-auto text-center mb-16 md:mb-24">
        <h2 class="font-serif text-3xl md:text-5xl text-on-background mb-6">Piezas hechas con propósito: Muebles que cuentan tu historia</h2>
        <div class="font-sans text-lg md:text-xl text-on-surface-variant leading-relaxed space-y-4">
          <p>
            Entendemos que un mueble no es un simple objeto de decoración; es el centro de tus reuniones familiares, tu espacio de inspiración para trabajar o tu refugio de descanso al finalizar el día. En <strong>Muebles Gumilla</strong>, diseñamos mobiliario bajo la premisa de crear <strong>piezas hechas con propósito</strong>, respondiendo a tus necesidades funcionales sin dejar de lado una estética elegante, cálida y atemporal. No creemos en la fabricación masiva ni en lo desechable; nuestro compromiso es entregar obras hechas a mano que se integren naturalmente a tu rutina, pensadas para durar <strong>para toda la vida</strong>.
          </p>
          <p>
            La madera maciza tiene la particularidad de envejecer con gracia. Sus marcas y variaciones de color a lo largo del tiempo van contando la historia de tu hogar. Nuestro taller de carpintería en Santiago es el lugar donde esa historia comienza, combinando el diseño moderno con la firmeza de la técnica clásica chilena para ofrecerte mobiliario que supera cualquier estándar comercial en resistencia y belleza visual.
          </p>
        </div>
      </div>
      
      <!-- Zig Zag: Catálogo -->
      <div class="flex flex-col gap-16 md:gap-24 mb-24">
        <div class="text-center">
          <h3 class="font-serif text-3xl md:text-4xl text-on-background mb-4">Nuestro Catálogo de Madera Maciza</h3>
          <p class="font-sans text-on-surface-variant max-w-3xl mx-auto text-lg leading-relaxed">
            Explorar nuestro catálogo es adentrarse en un mundo donde la nobleza de los materiales dicta las reglas. Nos especializamos en trabajar maderas nativas chilenas y opciones nobles como el roble, lenga y raulí, ofreciendo una variedad de categorías adaptables a cualquier espacio.
          </p>
        </div>

        <!-- Row 1: Camas -->
        <div class="flex flex-col md:flex-row gap-8 lg:gap-16 items-center">
          <div class="w-full md:w-1/2">
            <div class="bg-white p-5 sm:p-6 rounded-2xl border-2 border-white shadow-md">
              <div class="relative aspect-[4/3] overflow-hidden bg-beige-700 rounded-lg shadow-inner">
                <Image src={import('../assets/productos/placeholder_cama.png')} alt="Camas y Dormitorios a Medida" class="absolute inset-0 w-full h-full object-cover" width={600} quality={90} />
              </div>
            </div>
          </div>
          <div class="w-full md:w-1/2 flex flex-col gap-4">
            <h4 class="font-serif text-2xl md:text-3xl text-on-background">Camas y Dormitorios</h4>
            <p class="font-sans text-on-surface-variant leading-relaxed text-lg">
              Nuestras camas, en particular las de estilo japonés, son estructuras bajas y minimalistas que invitan al descanso profundo. Eliminamos los ruidos estructurales utilizando ensambles de carpintería tradicional, logrando bases firmes, silenciosas y elegantes.
            </p>
          </div>
        </div>

        <!-- Row 2: Mesas -->
        <div class="flex flex-col md:flex-row-reverse gap-8 lg:gap-16 items-center">
          <div class="w-full md:w-1/2">
            <div class="bg-white p-5 sm:p-6 rounded-2xl border-2 border-white shadow-md">
              <div class="relative aspect-[4/3] overflow-hidden bg-beige-700 rounded-lg shadow-inner">
                <Image src={import('../assets/productos/placeholder_mesa.png')} alt="Mesas de Comedor en Madera Maciza" class="absolute inset-0 w-full h-full object-cover" width={600} quality={90} />
              </div>
            </div>
          </div>
          <div class="w-full md:w-1/2 flex flex-col gap-4">
            <h4 class="font-serif text-2xl md:text-3xl text-on-background">Mesas de Comedor y Centro</h4>
            <p class="font-sans text-on-surface-variant leading-relaxed text-lg">
              El comedor es el corazón de cualquier casa. Construimos mesas robustas y amplias, cuyas cubiertas de madera maciza exhiben vetas únicas e irrepetibles. Las tratamos con ceras y aceites naturales que las protegen del roce diario y la humedad, manteniendo su calidez al tacto.
            </p>
          </div>
        </div>

        <!-- Row 3: Estantes -->
        <div class="flex flex-col md:flex-row gap-8 lg:gap-16 items-center">
          <div class="w-full md:w-1/2">
            <div class="bg-white p-5 sm:p-6 rounded-2xl border-2 border-white shadow-md">
              <div class="relative aspect-[4/3] overflow-hidden bg-beige-700 rounded-lg shadow-inner">
                <Image src={import('../assets/productos/placeholder_estante.png')} alt="Estantes y Soluciones de Almacenaje" class="absolute inset-0 w-full h-full object-cover" width={600} quality={90} />
              </div>
            </div>
          </div>
          <div class="w-full md:w-1/2 flex flex-col gap-4">
            <h4 class="font-serif text-2xl md:text-3xl text-on-background">Estantes y Almacenaje</h4>
            <p class="font-sans text-on-surface-variant leading-relaxed text-lg">
              Diseñamos soluciones de guardado funcionales. Desde repisas suspendidas hasta estanterías modulares, cada pieza se calcula minuciosamente para soportar peso sin deformarse, optimizando el uso de tus muros y rincones vacíos con un diseño estrictamente a medida.
            </p>
          </div>
        </div>
      </div>

      <!-- El Proceso de Diseño a Medida -->
      <div class="bg-white p-8 md:p-12 lg:p-16 rounded-3xl border border-outline/10 shadow-lg">
        <h3 class="font-serif text-3xl md:text-4xl text-on-background mb-8 text-center">El Proceso de Diseño a Medida</h3>
        
        <div class="font-sans text-on-surface-variant leading-relaxed text-lg mb-12 max-w-4xl mx-auto text-center">
          <p>
            Sabemos que la estandarización no siempre funciona. Cada hogar en Chile, ya sea un departamento moderno o una casa clásica de época, posee dimensiones y distribuciones particulares que requieren estrictamente de un <strong>diseño a medida</strong>.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
          <div class="flex flex-col gap-4">
            <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center text-on-background mb-2 font-serif text-2xl">1</div>
            <h4 class="font-serif text-2xl text-on-background">Contacto y Cotización</h4>
            <p class="font-sans text-on-surface-variant leading-relaxed text-base">
              El primer paso es contactarnos por WhatsApp. Ahí conversamos de forma directa; nos puedes enviar fotos del espacio, referencias visuales o contarnos tu problema de diseño. Esta comunicación directa asegura que no haya intermediarios ni malentendidos durante todo el proceso.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center text-on-background mb-2 font-serif text-2xl">2</div>
            <h4 class="font-serif text-2xl text-on-background">Materiales y Ajustes</h4>
            <p class="font-sans text-on-surface-variant leading-relaxed text-base">
              Te asesoramos sobre qué madera es ideal para tu proyecto. ¿Buscas un tono claro y luminoso? El pino radiata o la lenga pueden ser perfectos. ¿Prefieres un tono profundo y clásico? El roble o raulí son opciones infalibles. Además, ajustamos cada centímetro para asegurar ergonomía.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center text-on-background mb-2 font-serif text-2xl">3</div>
            <h4 class="font-serif text-2xl text-on-background">Desarrollo y Entrega</h4>
            <p class="font-sans text-on-surface-variant leading-relaxed text-base">
              Una vez aprobado el diseño, el taller entra en acción. Durante los días de fabricación, mantenemos altísimos estándares de control de calidad. Al finalizar, entregamos un mueble listo para ser disfrutado, construido éticamente y pensado hasta en el último de los detalles.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección SEO / Proceso Artesanal (Corta) -->
  <section class="py-16 bg-white mb-section-gap">
    <div class="max-w-[1440px] mx-auto px-margin-mobile lg:px-margin-desktop grid md:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col gap-6">
        <h2 class="font-serif text-3xl md:text-4xl text-on-background">Nuestro Proceso Artesanal</h2>
        <div class="font-sans text-on-surface-variant text-base md:text-lg space-y-4">
          <p>
            En Muebles Gumilla, creemos que cada mueble debe contar una historia y acompañarte para toda la vida. Por más de seis años, nuestro taller ubicado en el corazón de Santiago de Chile se ha dedicado a la <strong>fabricación de muebles de madera a medida</strong>, priorizando la calidad, el detalle y la nobleza de los materiales. 
          </p>
          <p>
            Trabajamos con maderas cuidadosamente seleccionadas como <strong>roble, raulí, lenga y pino radiata</strong>, asegurando que cada veta y textura se resalte en el resultado final. Nuestro proceso comienza contigo: nos cuentas tu idea y diseñamos piezas únicas que se ajustan exactamente a las dimensiones de tus espacios.
          </p>
          <p>
            A diferencia de la producción industrial, nuestro proceso es 100% <strong>artesanal y hecho a mano</strong>. Esto nos permite garantizar un ensamblaje robusto y terminaciones premium, utilizando aceites y selladores naturales que protegen la madera sin alterar su esencia. El tiempo de confección de cada encargo varía según su complejidad, pero generalmente entregamos nuestras piezas entre 15 y 20 días hábiles, asegurando que el trabajo se realice con la dedicación que merece.
          </p>
          <p>
            Elegir un mueble a medida no es solo comprar un objeto, es invertir en durabilidad, diseño consciente y apoyo a la artesanía local chilena. 
          </p>
        </div>
        <Button href="/sobre-el-taller" variant="secondary" class="mt-2 w-fit shadow-sm">
          Conoce más sobre el taller
        </Button>
      </div>
      <div class="relative aspect-[4/3] rounded-2xl overflow-hidden shadow-xl hidden md:block bg-white p-5 md:p-6 border-2 border-white">
        <div class="relative w-full h-full rounded-xl overflow-hidden bg-beige-700 shadow-inner">
          <Image src={tallerImage} alt="Proceso artesanal en Muebles Gumilla - Taller en Santiago" class="absolute inset-0 w-full h-full object-cover" width={800} height={600} />
        </div>
      </div>
    </div>
  </section>

  <!-- Productos Destacados -->
  <section class="pt-28 pb-16 md:pt-36 md:pb-24">
    <div class="max-w-[1440px] mx-auto">
      <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl text-on-background mb-14 text-center">Piezas Destacadas</h2>
      
      <div class="flex flex-wrap justify-center gap-6 lg:gap-8">
        {resolvedDestacados.map(producto => {
          return (
          <div class="w-full sm:w-[calc(50%-1.5rem)] lg:w-[calc(25%-1.5rem)] max-w-[280px]">
            <ProductCard 
              nombre={producto.data.nombre}
              categoria={producto.resolvedCategoryName}
              precio_referencial={producto.data.precio_referencial}
              medida_principal={`${producto.data.medidas.alto}x${producto.data.medidas.ancho}x${producto.data.medidas.profundidad}${producto.data.medidas.unidad}`}
              imagen={producto.data.imagenes[0]}
              url={`/catalogo/${producto.slug}`}
            />
          </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative w-full py-24 md:py-32 flex flex-col items-center text-center px-margin-mobile lg:px-margin-desktop overflow-hidden">
    <div class="absolute inset-0 w-full h-full">
      <Image src={bosqueChileno} alt="Bosque Chileno - Inspiración Natural" class="w-full h-full object-cover" width={1920} quality={80} />
      <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <div class="relative z-10 max-w-3xl w-full flex flex-col items-center gap-8 bg-white/95 backdrop-blur-md p-8 md:p-12 lg:p-16 rounded-3xl shadow-2xl border border-white/50">
      <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl text-on-background">¿Buscas algo a medida?</h2>
      <div class="font-sans text-on-surface-variant text-lg md:text-xl space-y-4">
        <p>
          Sabemos que cada hogar es único y requiere soluciones pensadas específicamente para él. Si tienes un diseño en mente o necesitas adaptar alguna de nuestras piezas a dimensiones particulares, estamos listos para ayudarte.
        </p>
        <p>
          En Muebles Gumilla transformamos tus ideas en realidad. Conversemos sobre tu próximo proyecto y descubre cómo podemos aportar calidez y funcionalidad a tus espacios.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row w-full sm:w-auto gap-4 mt-4">
        <Button href={`https://wa.me/${siteConfig.whatsappNumber}`} variant="primary" isExternal={true} class="w-full sm:w-auto shadow-md">
          Hablemos por WhatsApp
        </Button>
        <Button href={siteConfig.mapsUrl} variant="outline" isExternal={true} class="w-full sm:w-auto flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Visítanos en el Taller
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
